Cell[BoxData[
 RowBox[{
  RowBox[{"Mu", "[", 
   RowBox[{"{", 
    RowBox[{"l_", ",", "m_", ",", "r_", ",", "s_"}], "}"}], "]"}], " ", ":=", 
  " ", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "lambda", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"lambda", " ", "=", " ", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"2", "l"}], " ", "+", " ", 
         RowBox[{"2", "m"}], " ", "+", " ", 
         RowBox[{"2", "r"}], " ", "+", " ", "s"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"2", "m"}], " ", "+", 
         RowBox[{"2", "r"}], " ", "+", "s"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"2", "r"}], " ", "+", "s"}], ",", "\[IndentingNewLine]", 
        "s"}], "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"WeightAdd", "[", 
      RowBox[{"lambda", ",", " ", "rho"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
