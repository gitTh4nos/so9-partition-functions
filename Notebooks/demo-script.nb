Cell[BoxData[
 RowBox[{
  RowBox[{"AnsatzReps", "[", "n_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"reps", "=", 
      RowBox[{"{", "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", "\[IndentingNewLine]", "   ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"a", "+", 
            RowBox[{"3", " ", "b"}], "+", 
            RowBox[{"2", " ", "d"}]}], "<=", 
           RowBox[{"n", " ", "-", " ", "1"}]}], "\[IndentingNewLine]", "&&", 
          RowBox[{
           RowBox[{"a", "+", 
            RowBox[{"3", " ", "b"}], "+", 
            RowBox[{"6", " ", "c"}], "+", 
            RowBox[{"3", " ", "d"}]}], "<=", 
           RowBox[{"n", "+", "1"}]}], "\[IndentingNewLine]", "&&", 
          RowBox[{
           RowBox[{"a", "+", 
            RowBox[{"3", " ", "b"}], "+", 
            RowBox[{"6", " ", "c"}], "+", 
            RowBox[{"4", " ", "d"}]}], "<=", 
           RowBox[{"n", "+", "2"}]}], "\[IndentingNewLine]", "&&", 
          RowBox[{
           RowBox[{"a", "+", 
            RowBox[{"3", " ", "b"}], "+", 
            RowBox[{"6", " ", "c"}], "+", 
            RowBox[{"5", " ", "d"}]}], "<=", 
           RowBox[{"n", "+", "6"}]}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"reps", ",", 
           RowBox[{"{", 
            RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}]}], "]"}]}], 
        "\[IndentingNewLine]", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"a", ",", "0", ",", 
         RowBox[{"n", " ", "-", " ", "1"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"b", ",", "0", ",", 
         RowBox[{"Floor", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"n", " ", "-", " ", "1"}], ")"}], "/", "3"}], "]"}]}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"c", ",", "0", ",", 
         RowBox[{"Floor", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"n", "+", "1"}], ")"}], "/", "6"}], "]"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"d", ",", "0", ",", 
         RowBox[{"Floor", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"n", " ", "-", " ", "1"}], ")"}], "/", "2"}], "]"}]}], 
        "}"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Sort", "[", "reps", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9950175103031826`*^9, 3.995017621285616*^9}, {
  3.9950193887772694`*^9, 3.9950193920240364`*^9}, {3.9954304607895985`*^9, 
