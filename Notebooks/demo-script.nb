  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ThetaWeight", "[", 
    RowBox[{"weight_", ",", "K_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "e1", ",", "e2", ",", "e3", ",", "e4", ",", "ta", ",", "tb", ",", 
       "val3", ",", "val4", ",", "valB"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"e1", ",", "e2", ",", "e3", ",", "e4"}], "}"}], "=", 
       "weight"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"ta", "=", 
       RowBox[{
        RowBox[{"2", "*", "K"}], "+", "1"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"tb", "=", 
       RowBox[{"2", "*", "K"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"val3", "=", 
       RowBox[{"Coefficient", "[", 
        RowBox[{
         RowBox[{"Expand", "[", 
