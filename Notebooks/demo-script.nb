Cell[BoxData[
 RowBox[{
  RowBox[{"SignedDominantRep", "[", "weight_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
     "absWeight", ",", "\[IndentingNewLine]", "dominant", ",", 
      "\[IndentingNewLine]", "sign", ",", "\[IndentingNewLine]", "rep"}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"absWeight", "=", 
      RowBox[{"Abs", "[", "weight", "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{"absWeight", ",", "0"}], "]"}], "||", 
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"DeleteDuplicates", "[", "absWeight", "]"}], "]"}], "<", 
         "4"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{"$Failed", ",", "0"}], "}"}], "]"}]}], "\[IndentingNewLine]",
       "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"dominant", "=", 
      RowBox[{"Sort", "[", 
       RowBox[{"absWeight", ",", "Greater"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sign", "=", 
      RowBox[{
       RowBox[{"Signature", "[", 
        RowBox[{"Ordering", "[", 
         RowBox[{"absWeight", ",", "All", ",", "Greater"}], "]"}], "]"}], "*", 
       RowBox[{"Product", "[", 
        RowBox[{
         RowBox[{"Sign", "[", "w", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"w", ",", "weight"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rep", "=", 
      RowBox[{"RepFromMu", "[", "dominant", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"rep", ",", "sign"}], "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9950177849149113`*^9, 3.995017822579691*^9}, {
  3.9950178916289616`*^9, 3.9950179328170986`*^9}, {3.995018017081867*^9, 
  3.995018029018488*^9}, {3.9950182531800175`*^9, 3.995018255188286*^9}, {
