Cell[BoxData[{
 RowBox[{
  RowBox[{"ThetaOrder", "=", "4"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"maxQ", "=", 
    RowBox[{
     RowBox[{"2", "*", "ThetaOrder"}], "+", "3"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Hpoly", "=", 
   RowBox[{"1", "+", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "^", "n"}], "*", 
       RowBox[{"Q", "^", 
        RowBox[{"(", 
         RowBox[{"n", "*", 
          RowBox[{"(", 
           RowBox[{"n", "+", "1"}], ")"}]}], ")"}]}], "*", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"x", "^", 
          RowBox[{"(", 
           RowBox[{"2", "*", "k"}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"-", "n"}], ",", "n"}], "}"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "1", ",", 
        RowBox[{"Ceiling", "[", 
         RowBox[{"Sqrt", "[", "maxQ", "]"}], "]"}]}], "}"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Cpoly", "=", 
   RowBox[{"1", "+", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Q", "^", 
        RowBox[{"(", 
         RowBox[{"n", "^", "2"}], ")"}]}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"x", "^", 
          RowBox[{"(", 
           RowBox[{"2", "*", "n"}], ")"}]}], "+", 
         RowBox[{"x", "^", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "2"}], "*", "n"}], ")"}]}]}], ")"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "1", ",", 
        RowBox[{"Ceiling", "[", 
         RowBox[{"Sqrt", "[", "maxQ", "]"}], "]"}]}], "}"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Dpoly", "=", 
   RowBox[{"1", "+", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "^", "n"}], "*", 
       RowBox[{"Q", "^", 
        RowBox[{"(", 
         RowBox[{"n", "^", "2"}], ")"}]}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"x", "^", 
          RowBox[{"(", 
           RowBox[{"2", "*", "n"}], ")"}]}], "+", 
         RowBox[{"x", "^", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "2"}], "*", "n"}], ")"}]}]}], ")"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "1", ",", 
        RowBox[{"Ceiling", "[", 
         RowBox[{"Sqrt", "[", "maxQ", "]"}], "]"}]}], "}"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Bpoly", "=", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Q", "^", 
        RowBox[{"(", 
         RowBox[{"n", "*", 
          RowBox[{"(", 
           RowBox[{"n", "+", "1"}], ")"}]}], ")"}]}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"x", "^", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "*", "n"}], "+", "1"}], ")"}]}], "+", 
         RowBox[{"x", "^", 
          RowBox[{"(", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "*", "n"}], "+", "1"}], ")"}]}], ")"}]}]}], 
        ")"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "0", ",", 
        RowBox[{"Ceiling", "[", 
         RowBox[{"Sqrt", "[", "maxQ", "]"}], "]"}]}], "}"}]}], "]"}]}], ";"}],
   "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Fpoly", "=", 
    RowBox[{"Normal", "[", 
     RowBox[{"Series", "[", 
      RowBox[{
       RowBox[{"1", "/", "Hpoly"}], ",", 
       RowBox[{"{", 
        RowBox[{"Q", ",", "0", ",", "maxQ"}], "}"}]}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"G3poly", "=", 
    RowBox[{"Expand", "[", "\[IndentingNewLine]", 
     RowBox[{"Normal", "[", 
      RowBox[{"Series", "[", 
       RowBox[{
        RowBox[{"Fpoly", "*", "Cpoly"}], ",", 
        RowBox[{"{", 
         RowBox[{"Q", ",", "0", ",", "maxQ"}], "}"}]}], "]"}], "]"}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"G4poly", "=", 
    RowBox[{"Expand", "[", "\[IndentingNewLine]", 
     RowBox[{"Normal", "[", 
      RowBox[{"Series", "[", 
       RowBox[{
        RowBox[{"Fpoly", "*", "Dpoly"}], ",", 
        RowBox[{"{", 
         RowBox[{"Q", ",", "0", ",", "maxQ"}], "}"}]}], "]"}], "]"}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GBpoly", "=", 
   RowBox[{"Expand", "[", "\[IndentingNewLine]", 
    RowBox[{"Normal", "[", 
     RowBox[{"Series", "[", 
      RowBox[{
       RowBox[{"Fpoly", "*", "Bpoly"}], ",", 
       RowBox[{"{", 
        RowBox[{"Q", ",", "0", ",", "maxQ"}], "}"}]}], "]"}], "]"}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
