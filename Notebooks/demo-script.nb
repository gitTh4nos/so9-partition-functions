Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"weylRhoShifts", "=", 
    RowBox[{"Flatten", "[", "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"Table", "[", "\[IndentingNewLine]", "\t", 
       RowBox[{
        RowBox[{"Module", "[", "\[IndentingNewLine]", "\t", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"base", ",", "pSign", ",", "weight", ",", "totalSign"}], 
           "}"}], ",", "\[IndentingNewLine]", "\t", 
          RowBox[{
           RowBox[{"pSign", "=", 
            RowBox[{"Signature", "[", "perm", "]"}]}], ";", 
           "\[IndentingNewLine]", "\t", 
           RowBox[{"base", "=", 
            RowBox[{"rho", "[", 
             RowBox[{"[", "perm", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           "\t", 
           RowBox[{"weight", "=", 
            RowBox[{"signs", "*", "base"}]}], ";", "\[IndentingNewLine]", 
           "\t", 
           RowBox[{"totalSign", "=", 
            RowBox[{"pSign", "*", 
             RowBox[{"Times", "@@", "signs"}]}]}], ";", "\[IndentingNewLine]",
            "\t", 
           RowBox[{"{", 
            RowBox[{"weight", ",", "totalSign"}], "}"}]}]}], 
         "\[IndentingNewLine]", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"perm", ",", 
          RowBox[{"Permutations", "[", 
           RowBox[{"Range", "[", "4", "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"signs", ",", 
          RowBox[{"Tuples", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "4"}], "]"}]}], 
         "}"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", ",", 
      "1"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Length", "[", "weylRhoShifts", "]"}]}], "Input",
 CellChangeTimes->{{3.995017090420681*^9, 3.995017090420681*^9}, {
