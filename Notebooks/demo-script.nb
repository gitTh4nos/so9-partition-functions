Cell[BoxData[
 RowBox[{
  RowBox[{"RepFromMu", "[", "muList_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"lam", ",", "dl", ",", "dm", ",", "dr", ",", "s"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"lam", "=", 
      RowBox[{"WeightSubtract", "[", 
       RowBox[{"muList", ",", "rho"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dl", "=", 
      RowBox[{
       RowBox[{"lam", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "-", 
       RowBox[{"lam", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dm", "=", 
      RowBox[{
       RowBox[{"lam", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "-", 
       RowBox[{"lam", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dr", "=", 
      RowBox[{
       RowBox[{"lam", "[", 
        RowBox[{"[", "3", "]"}], "]"}], "-", 
       RowBox[{"lam", "[", 
        RowBox[{"[", "4", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"s", "=", 
      RowBox[{"lam", "[", 
       RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Min", "[", 
          RowBox[{"dl", ",", "dm", ",", "dr", ",", "s"}], "]"}], "<", "0"}], "||", 
        RowBox[{"OddQ", "[", "dl", "]"}], "||", 
        RowBox[{"OddQ", "[", "dm", "]"}], "||", 
        RowBox[{"OddQ", "[", "dr", "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "$Failed", "]"}]}], "\[IndentingNewLine]", 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dl", "/", "2"}], ",", 
       RowBox[{"dm", "/", "2"}], ",", 
       RowBox[{"dr", "/", "2"}], ",", "s"}], "}"}]}]}], "\[IndentingNewLine]",
    "]"}]}]], "Input",
 CellChangeTimes->{{3.9950017819603558`*^9, 3.995001853146803*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"233e66b9-30ae-534d-890c-703d61f8bd1d"]
