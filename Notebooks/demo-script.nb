Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "a", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"a", "[", "_", "]"}], "=", "0"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"ansatz", "=", 
   RowBox[{"AnsatzReps", "[", "ThetaOrder", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"descendingAnsatz", "=", 
    RowBox[{"SortBy", "[", 
     RowBox[{"ansatz", ",", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Mu", "[", "#", "]"}]}], "&"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Computing multiplicities for \>\"", ",", 
     RowBox[{"Length", "[", "descendingAnsatz", "]"}], ",", 
     "\"\< representations at order \>\"", ",", "ThetaOrder", ",", 
     "\"\<...\>\""}], "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "mu", ",", "gamma", ",", "rhs", ",", "correction", ",", 
         "shiftedWeight", ",", "alpha", ",", "neighborRep", ",", "sg"}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"mu", "=", 
         RowBox[{"Mu", "[", "rep", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"gamma", "=", 
         RowBox[{"WeightAdd", "[", 
          RowBox[{"mu", ",", "etaStar"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"rhs", "=", "0"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"shiftedWeight", "=", 
            RowBox[{"WeightSubtract", "[", 
             RowBox[{"gamma", ",", 
              RowBox[{"shift", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"rhs", "+=", 
            RowBox[{
             RowBox[{"shift", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "*", 
             RowBox[{"ThetaWeight", "[", 
              RowBox[{"shiftedWeight", ",", "ThetaOrder"}], "]"}]}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"shift", ",", "weylRhoShifts"}], "}"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"correction", "=", "0"}], ";", "\[IndentingNewLine]", 
        RowBox[{"KeyValueMap", "[", "\[IndentingNewLine]", "\t", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"eta", ",", "coeff"}], "}"}], ",", "\[IndentingNewLine]",
             "\t\t", 
            RowBox[{
             RowBox[{"alpha", "=", 
              RowBox[{"WeightSubtract", "[", 
               RowBox[{"gamma", ",", "eta"}], "]"}]}], ";", 
             "\[IndentingNewLine]", "\t\t", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"neighborRep", ",", "sg"}], "}"}], "=", 
              RowBox[{"SignedDominantRep", "[", "alpha", "]"}]}], ";", 
             "\[IndentingNewLine]", "\t\t", 
             RowBox[{"If", "[", "\[IndentingNewLine]", "\t\t", 
              RowBox[{
               RowBox[{"neighborRep", "=!=", "$Failed"}], ",", 
               "\[IndentingNewLine]", "\t\t", 
               RowBox[{"correction", "+=", 
                RowBox[{"coeff", "*", "sg", "*", 
                 RowBox[{"a", "[", "neighborRep", "]"}]}]}]}], 
              "\[IndentingNewLine]", "\t", "]"}], ";"}]}], 
           "\[IndentingNewLine]", "\t", "]"}], ",", "zqTail"}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"a", "[", "rep", "]"}], "=", 
         RowBox[{"rhs", "-", "correction"}]}], ";"}]}], "\[IndentingNewLine]",
       "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"rep", ",", "descendingAnsatz"}], "}"}]}], 
    "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"nonzeroMultiplicities", "=", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"AssociationMap", "[", 
      RowBox[{"a", ",", "descendingAnsatz"}], "]"}], ",", 
     RowBox[{
      RowBox[{"#", "!=", "0"}], "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Done. Nonzero representations: \>\"", ",", 
