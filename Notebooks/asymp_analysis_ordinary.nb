                    RowBox[{"Repsum", "[", 
                    RowBox[{"5", ",", "coeff52", ",", "t0"}], "]"}]}]}], 
                    "]"}]}]}], "/.", 
                 RowBox[{"{", 
                  RowBox[{"x", "->", 
                   SqrtBox[
                    RowBox[{"2", "i"}]]}], "}"}]}], "]"}]}], ")"}], ")"}]}], 
           "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "3", ",", "max"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "rad12345list", "]"}], ";"}], ",", 
