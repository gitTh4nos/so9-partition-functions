     RowBox[{"{", 
      RowBox[{
       RowBox[{"t2functions", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
       RowBox[{"CoefficientList", "[", 
        RowBox[{
         RowBox[{"Normal", "[", 
          RowBox[{"Series", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"t2functions", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "2"}], "]"}], "]"}], "/", 
             RowBox[{"t", "^", "21"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "0", ",", 
              RowBox[{"15", "+", "N2level"}]}], "}"}]}], "]"}], "]"}], ",", 
         "t"}], "]"}], ",", 
       RowBox[{"CoefficientList", "[", 
        RowBox[{
         RowBox[{"Normal", "[", 
          RowBox[{"Series", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"t2functions", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "3"}], "]"}], "]"}], "/", 
             RowBox[{"t", "^", "15"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "0", ",", 
              RowBox[{"15", "+", "N2level"}]}], "}"}]}], "]"}], "]"}], ",", 
         "t"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Length", "[", "replist", "]"}]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
