           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
       RowBox[{"coeff3", "=", 
        RowBox[{"coeff3list", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Transpose", "[", "coeff3list", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", "rep"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
       RowBox[{"coeff4", "=", 
        RowBox[{"coeff4list", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Transpose", "[", "coeff4list", "]"}], "[", 
