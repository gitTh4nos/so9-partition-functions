  RowBox[{"N3level", "=", "150"}], ";"}]], "Input",ExpressionUUID->"f82aac5e-83ec-4ab6-b8e0-14928e1bdc76"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Starting", " ", "powers", " ", "in", " ", "t", " ", "for", " ", "the", " ",
     "5", " ", "different", " ", "classes", " ", "of", " ", "peaks"}], "*)"}],
   "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"power3", "=", 
    RowBox[{"{", 
     RowBox[{"36", ",", "21", ",", "12", ",", "9", ",", "12"}], "}"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.99496864421281*^9, 3.9949687015634212`*^9}, {
