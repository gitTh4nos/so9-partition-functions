        RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"coeffT", "=", 
       RowBox[{
        RowBox[{"coefflist", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Transpose", "[", "coefflist", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", "rep"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"coeff2", "=", 
       RowBox[{"coeff2list", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Transpose", "[", "coeff2list", "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", "rep"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
      RowBox[{"coeff3", "=", 
       RowBox[{"coeff3list", "[", 
        RowBox[{"[", 
