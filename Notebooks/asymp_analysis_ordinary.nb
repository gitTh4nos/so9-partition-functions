                  RowBox[{"[", "n", "]"}], "]"}]}], ")"}]}], 
              RowBox[{"y4", "^", 
               RowBox[{"(", 
                RowBox[{"2", 
                 RowBox[{"a4", ".", 
                  RowBox[{"pwt", "[", 
                   RowBox[{"[", "n", "]"}], "]"}]}]}], ")"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"n", ",", "1", ",", 
               RowBox[{"Length", "[", "pwt", "]"}]}], "}"}]}], "]"}], "//", 
           "Factor"}], ")"}], "/", "WeylDen"}], "//", "Expand"}]}]}], "]"}]}],
    ";"}]}]], "Input",
