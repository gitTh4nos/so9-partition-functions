            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}], "]"}]}], ";", 
       RowBox[{"coeff52", "=", 
        RowBox[{"coeff5list", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", 
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Transpose", "[", 
                RowBox[{"coeff5list", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", "rep"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}], "]"}]}], ";", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Representation \>\"", "<>", 
         RowBox[{"ToString", "[", "rep", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rad12345list", "=", 
        RowBox[{"ParallelTable", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"(", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"data", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "[", "rep", "]"}], "-", 
               RowBox[{"Round", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Repsum1", "[", 
                   RowBox[{"x", ",", "coeffT"}], "]"}], "+", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"-", "I"}], ")"}], 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], "^", "i"}], " ", 
