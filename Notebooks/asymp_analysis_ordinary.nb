          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Representation \>\"", "<>", 
        RowBox[{"ToString", "[", "rep", "]"}]}], "]"}], ";", 
      RowBox[{"rad1234list", "=", 
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"(", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"data", "[", 
