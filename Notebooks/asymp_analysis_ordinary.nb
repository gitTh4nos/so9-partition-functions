Cell[BoxData[
 RowBox[{
  RowBox[{"t4functionstemp", "=", 
   RowBox[{"Monitor", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"na", "=", 
         RowBox[{"coeff4array", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ";", 
        RowBox[{"ParallelTable", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"rep", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"coeff4array", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], "Measurex", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"WeylChar", "[", "rep", "]"}], "/.", "yxsub"}], 
                   ")"}]}], "/.", 
                 RowBox[{"xsubc", "[", "4", "]"}]}], "//", "Expand"}], ")"}], 
              "/.", 
              RowBox[{"xruleac", "[", 
               RowBox[{
                RowBox[{"-", "1"}], ",", "4"}], "]"}]}], "//", "Simplify"}]}],
            "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"rep", ",", "replist"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "coeff4array", "]"}]}], "}"}]}], "]"}], ",", 
     "i"}], "]"}]}], ";"}]], "Input",
