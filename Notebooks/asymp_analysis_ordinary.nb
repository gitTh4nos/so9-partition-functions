                RowBox[{"t", "^", "15"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"t", ",", "0", ",", 
                 RowBox[{"15", "+", "N2level"}]}], "}"}]}], "]"}], "]"}], ",",
             "t"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "replist", "]"}]}], "}"}]}], "]"}]}], ";", 
     RowBox[{"Export", "[", 
