              RowBox[{"4", "-", 
               RowBox[{"Length", "[", 
                RowBox[{"IntegerDigits", "[", 
                 RowBox[{"n", ",", "2"}], "]"}], "]"}]}]}], "}"}]}], "]"}], ";", 
          RowBox[{"pwt", "=", 
           RowBox[{"Join", "[", 
            RowBox[{"pwt", ",", 
             RowBox[{"Transpose", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"-", "1"}], ")"}], "^", 
                  RowBox[{"ID", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], ",", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"-", "1"}], ")"}], "^", 
                  RowBox[{"ID", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], ",", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"-", "1"}], ")"}], "^", 
                  RowBox[{"ID", "[", 
                   RowBox[{"[", "3", "]"}], "]"}]}], ",", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"-", "1"}], ")"}], "^", 
                  RowBox[{"ID", "[", 
                   RowBox[{"[", "4", "]"}], "]"}]}]}], "}"}], 
               RowBox[{"Transpose", "[", "pwv", "]"}]}], "]"}]}], "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "0", ",", "15"}], "}"}]}], "]"}], ";", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"sigt", "[", 
               RowBox[{"[", "n", "]"}], "]"}], 
              RowBox[{"y1", "^", 
               RowBox[{"(", 
                RowBox[{"a1", ".", 
                 RowBox[{"pwt", "[", 
                  RowBox[{"[", "n", "]"}], "]"}]}], ")"}]}], 
              RowBox[{"y2", "^", 
               RowBox[{"(", 
                RowBox[{"a2", ".", 
