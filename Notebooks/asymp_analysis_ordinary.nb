      RowBox[{
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Transpose", "[", "coefflist", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", "rep"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"logdata", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          SqrtBox[
           RowBox[{"2", 
            RowBox[{"(", "j", ")"}]}]], ",", 
