Cell[BoxData[
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"cocompute", "[", 
    RowBox[{"[", "1", "]"}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Number", " ", "of", " ", "coefficients", " ", "to", " ", "generate"}], 
