   3.995898156643136*^9, 3.9958981625480547`*^9}, {3.995983822982171*^9, 
   3.995983850674447*^9}},ExpressionUUID->"26e8dade-2cd3-493d-954f-\
01a1a77ae5d9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"tcompute", "[", 
     RowBox[{"[", "3", "]"}], "]"}], ",", 
    RowBox[{
     RowBox[{"coeff3array", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"8", ",", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"1", "->", "0"}], ",", 
            RowBox[{"2", "->", "0"}], ",", 
            RowBox[{"3", "->", "0"}], ",", 
            RowBox[{"4", "->", "0"}]}], "|>"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"4", " ", "4", " ", 
           RowBox[{
            SuperscriptBox["2", "3"], "/", "2"}]}], ",", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"1", "->", "2"}], ",", 
            RowBox[{"2", "->", "0"}], ",", 
            RowBox[{"3", "->", "0"}], ",", 
            RowBox[{"4", "->", "0"}]}], "|>"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"6", " ", 
           SuperscriptBox["4", "2"], " ", 
           RowBox[{
            SuperscriptBox["2", "2"], "/", "2"}]}], ",", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"1", "->", "1"}], ",", 
            RowBox[{"2", "->", "1"}], ",", 
            RowBox[{"3", "->", "0"}], ",", 
            RowBox[{"4", "->", "0"}]}], "|>"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"4", " ", 
           SuperscriptBox["4", "3"], " ", 
           RowBox[{"2", "/", "2"}]}], ",", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"1", "->", "1"}], ",", 
            RowBox[{"2", "->", "1"}], ",", 
            RowBox[{"3", "->", "2"}], ",", 
            RowBox[{"4", "->", "0"}]}], "|>"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           SuperscriptBox["4", "4"], "/", "2"}], ",", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"1", "->", "1"}], ",", 
            RowBox[{"2", "->", "1"}], ",", 
            RowBox[{"3", "->", "1"}], ",", 
            RowBox[{"4", "->", "1"}]}], "|>"}]}], "}"}]}], "}"}]}], ";", 
     RowBox[{"t3functionstemp", "=", 
      RowBox[{"Monitor", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"na", "=", 
            RowBox[{"coeff3array", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ";", 
           RowBox[{"ParallelTable", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"rep", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"coeff3array", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], "Measurex", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"WeylChar", "[", "rep", "]"}], "/.", "yxsub"}], 
                    ")"}]}], "/.", 
                    RowBox[{"xsubc", "[", "3", "]"}]}], "//", "Expand"}], 
                  ")"}], "/.", 
                 RowBox[{"xruleac", "[", 
                  RowBox[{
                   RowBox[{"-", "1"}], ",", "3"}], "]"}]}], "//", 
                "Simplify"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"rep", ",", "replist"}], "}"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "coeff3array", "]"}]}], "}"}]}], "]"}], ",",
         "i"}], "]"}]}], ";", 
     RowBox[{"t3functions", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"t3functionstemp", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "i", ",", "1"}], "]"}], "]"}], "}"}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"t3functionstemp", "[", 
             RowBox[{"[", 
              RowBox[{"j", ",", "i", ",", "2"}], "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "5"}], "}"}]}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "replist", "]"}]}], "}"}]}], "]"}]}], ";", 
     RowBox[{"Export", "[", 
      RowBox[{"\"\<t3functions.m\>\"", ",", 
       RowBox[{"Compress", "[", "t3functions", "]"}]}], "]"}], ";"}]}], "]"}],
   ";"}]], "Input",
 CellChangeTimes->{{3.994954092804555*^9, 3.994954189950732*^9}, 
   3.994954249983124*^9, {3.995004190886468*^9, 3.995004192839739*^9}, {
   3.9959836288291693`*^9, 3.995983670102817*^9}},
 CellLabel->
  "In[280]:=",ExpressionUUID->"67ff88aa-e337-4f82-8d18-ed78e746baa2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"cocompute", "[", 
     RowBox[{"[", "3", "]"}], "]"}], ",", 
    RowBox[{
     RowBox[{"N3level", "=", "150"}], ";", 
     RowBox[{"(*", 
      RowBox[{
      "Starting", " ", "powers", " ", "in", " ", "t", " ", "for", " ", "the", 
       " ", "5", " ", "different", " ", "classes", " ", "of", " ", "peaks"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"power3", "=", 
      RowBox[{"{", 
       RowBox[{"36", ",", "21", ",", "12", ",", "9", ",", "12"}], "}"}]}], ";", 
     RowBox[{"coeff3list", "=", 
      RowBox[{"Monitor", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"t3functions", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "1"}], "]"}], "]"}], "}"}], ",", 
            RowBox[{"ParallelTable", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"CoefficientList", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Normal", "[", 
                   RowBox[{"Series", "[", 
                    RowBox[{
                    RowBox[{"t3functions", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", 
                    RowBox[{"j", "+", "1"}]}], "]"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"t", ",", "0", ",", 
                    RowBox[{"9", "+", "N3level"}]}], "}"}]}], "]"}], "]"}], "/", 
                  RowBox[{"t", "^", 
                   RowBox[{"(", 
                    RowBox[{"power3", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], ")"}]}]}], ",", "t"}], 
                "]"}], "//", "Simplify"}], ",", 
              RowBox[{"{", 
