                RowBox[{
                 RowBox[{"Repsum1", "[", 
                  RowBox[{"x", ",", "coeffT"}], "]"}], "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"-", "I"}], ")"}], 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], "^", "i"}], " ", 
                  RowBox[{"Repsum2", "[", "coeff2", "]"}]}], "+", 
                 RowBox[{"2", 
                  RowBox[{"Re", "[", 
                   RowBox[{
                    RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"-", "2"}], 
                    RowBox[{"\[Pi]", "/", "3"}], 
                    RowBox[{"(", 
                    RowBox[{"i", "+", "1"}], ")"}], "I"}], "]"}], 
                    RowBox[{"Repsum3", "[", "coeff3", "]"}]}], "]"}]}], "+", 
                 RowBox[{"2", 
                  RowBox[{"Re", "[", 
