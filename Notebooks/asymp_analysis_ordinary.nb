       RowBox[{"hwv", "=", 
        RowBox[{"wv", "+", "hw"}]}], ";", 
       RowBox[{"pwv", "=", 
        RowBox[{"Permutations", "[", "hwv", "]"}]}], ";", 
       RowBox[{"pwt", "=", 
        RowBox[{"{", "}"}]}], ";", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ID", "=", 
