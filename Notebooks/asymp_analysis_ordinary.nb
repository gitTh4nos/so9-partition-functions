Cell[CellGroupData[{

Cell["Fourth Rademacher", "Section",
 CellChangeTimes->{{3.986401113492135*^9, 3.986401117332183*^9}, {
  3.9916703482243843`*^9, 3.99167034908997*^9}, {3.991926553513433*^9, 
  3.9919265551355658`*^9}},ExpressionUUID->"baadca84-ebb1-45d2-98b4-\
5d2f57e5feae"],

Cell["\<\
The fourth Rademacher comes from \
(\[Omega]1,\[Omega]2,\[Omega]3,\[Omega]4)=(n1\[Pi]/4,n2\[Pi]/4,n3\[Pi]/4,n4\
\[Pi]/4) with n1+n2+n3+n4 odd.  This gives 6 distinct choices.\
\>", "Text",
 CellChangeTimes->{{3.992525590184106*^9, 3.992525635733474*^9}, {
  3.992525690068859*^9, 
  3.9925257905447598`*^9}},ExpressionUUID->"275a07fc-82e0-4255-9010-\
b33114c494a2"],

Cell[CellGroupData[{

Cell["\<\
Generate t4-functions for many reps [Only  run this if you want a new set of \
coefficient lists]\
\>", "Subsection",
 CellChangeTimes->{{3.994855554001539*^9, 3.9948555605560417`*^9}, {
   3.994856081925302*^9, 3.994856090068844*^9}, {3.994856212280854*^9, 
