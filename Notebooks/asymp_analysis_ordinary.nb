  3.995539456918317*^9}},ExpressionUUID->"72db9112-9ed6-4120-a4d7-\
92d5f4e8d717"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"rep", "=", 
      RowBox[{"replist", "[", 
       RowBox[{"[", "i", "]"}], "]"}]}], ";", 
     RowBox[{"posrep", "=", 
      RowBox[{
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Transpose", "[", "coefflist", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", "rep"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"logdata", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          SqrtBox[
           RowBox[{"2", 
            RowBox[{"(", "j", ")"}]}]], ",", 
          RowBox[{"Log", "[", 
           RowBox[{
            RowBox[{"data", "[", 
             RowBox[{"[", "j", "]"}], "]"}], "[", "rep", "]"}], "]"}]}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "maxlevel"}], "}"}]}], "]"}]}], ";", 
     RowBox[{"bplot", "=", 
      RowBox[{"ListPlot", "[", 
       RowBox[{"logdata", ",", 
        RowBox[{"PlotStyle", "->", "Red"}], ",", 
        RowBox[{"AxesLabel", "->", 
