Cell[BoxData[{
 RowBox[{
  RowBox[{"Nlevel", "=", "150"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"N2level", "=", "200"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"max", "=", "200"}], ";"}]}], "Input",
 CellChangeTimes->{{3.994951586013563*^9, 3.994951618520877*^9}, {
