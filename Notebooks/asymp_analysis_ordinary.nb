                  RowBox[{"2", 
                   RowBox[{"Re", "[", 
                    RowBox[{
                    RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"-", "2"}], 
                    RowBox[{"\[Pi]", "/", "3"}], 
                    RowBox[{"(", 
                    RowBox[{"i", "+", "1"}], ")"}], "I"}], "]"}], 
                    RowBox[{"Repsum3", "[", "coeff3", "]"}]}], "]"}]}], "+", 
