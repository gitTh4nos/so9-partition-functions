Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"rep", "=", 
       RowBox[{"replist", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"coeffT", "=", 
       RowBox[{
        RowBox[{"coefflist", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Transpose", "[", "coefflist", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", "rep"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"coeff2", "=", 
       RowBox[{"coeff2list", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Transpose", "[", "coeff2list", "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", "rep"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Representation \>\"", "<>", 
        RowBox[{"ToString", "[", "rep", "]"}]}], "]"}], ";", 
      RowBox[{"rad12list", "=", 
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"(", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"data", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "[", "rep", "]"}], "-", 
              RowBox[{"Round", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Repsum1", "[", 
                  RowBox[{"x", ",", "coeffT"}], "]"}], "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"-", "I"}], ")"}], 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], "^", "i"}], " ", 
                  RowBox[{"Repsum2", "[", "coeff2", "]"}]}]}], "/.", 
                RowBox[{"{", 
                 RowBox[{"x", "->", 
                  SqrtBox[
                   RowBox[{"2", "i"}]]}], "}"}]}], "]"}]}], ")"}], ")"}]}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "3", ",", "max"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"Show", "[", 
        RowBox[{"ListPlot", "[", "rad12list", "]"}], "]"}], "]"}], ";"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Length", "[", "replist", "]"}]}], "}"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.994860134839306*^9, 3.994860167660606*^9}, {
  3.99486019794158*^9, 3.994860290491384*^9}, {3.994865572046846*^9, 
