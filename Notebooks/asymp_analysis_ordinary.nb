 CellLabel->"In[98]:=",ExpressionUUID->"f05df10d-9062-44b5-9eef-d6f8dec121fc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"t3functions", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t3functionstemp", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "i", ",", "1"}], "]"}], "]"}], "}"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
