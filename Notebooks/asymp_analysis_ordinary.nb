Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"List", " ", "of", " ", "shifts", " ", 
    RowBox[{"(", "second", ")"}], " ", "and", " ", "the", " ", "degeneracy", " ",
     "for", " ", "each", " ", "shift", " ", 
    RowBox[{"(", "first", ")"}]}], "*)"}], 
  RowBox[{
   RowBox[{"coeff4array", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"4", " ", "4", " ", 
         SuperscriptBox["2", "3"]}], ",", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"1", "->", "1"}], ",", 
          RowBox[{"2", "->", "0"}], ",", 
          RowBox[{"3", "->", "0"}], ",", 
          RowBox[{"4", "->", "0"}]}], "|>"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"4", " ", 
         SuperscriptBox["4", "3"], "2"}], ",", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"1", "->", "1"}], ",", 
          RowBox[{"2", "->", "1"}], ",", 
          RowBox[{"3", "->", "1"}], ",", 
          RowBox[{"4", "->", "0"}]}], "|>"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"12", " ", "4", " ", "2", " ", 
         RowBox[{"2", "^", "2"}]}], ",", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"1", "->", "1"}], ",", 
          RowBox[{"2", "->", "2"}], ",", 
          RowBox[{"3", "->", "0"}], ",", 
          RowBox[{"4", "->", "0"}]}], "|>"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"12", " ", "4", " ", 
         SuperscriptBox["2", "2"], "2"}], ",", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"1", "->", "1"}], ",", 
          RowBox[{"2", "->", "2"}], ",", 
          RowBox[{"3", "->", "2"}], ",", 
          RowBox[{"4", "->", "0"}]}], "|>"}]}], "\[IndentingNewLine]", "}"}], 
      ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"4", " ", "4", " ", 
         SuperscriptBox["2", "3"]}], ",", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"1", "->", "1"}], ",", 
          RowBox[{"2", "->", "2"}], ",", 
          RowBox[{"3", "->", "2"}], ",", 
