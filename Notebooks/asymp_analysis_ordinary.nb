            RowBox[{"\[Pi]", "/", "c"}]}], "]"}]}], "-", 
         RowBox[{
          RowBox[{"1", "/", 
           RowBox[{"x", "[", "i", "]"}]}], 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "I"}], " ", 
            RowBox[{"n", "[", 
             RowBox[{"[", "i", "]"}], "]"}], 
