Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"cocompute", "[", 
     RowBox[{"[", "2", "]"}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"N2level", "=", "200"}], ";", 
     RowBox[{"coeff2list", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"t2functions", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
          RowBox[{"CoefficientList", "[", 
           RowBox[{
            RowBox[{"Normal", "[", 
             RowBox[{"Series", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"t2functions", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "2"}], "]"}], "]"}], "/", 
                RowBox[{"t", "^", "21"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"t", ",", "0", ",", 
                 RowBox[{"15", "+", "N2level"}]}], "}"}]}], "]"}], "]"}], ",",
             "t"}], "]"}], ",", 
          RowBox[{"CoefficientList", "[", 
           RowBox[{
            RowBox[{"Normal", "[", 
