                    RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"-", "2"}], 
                    RowBox[{"\[Pi]", "/", "4"}], 
                    RowBox[{"(", 
                    RowBox[{"i", "+", 
                    RowBox[{"3", "/", "2"}]}], ")"}], "I"}], "]"}], 
                    RowBox[{"Repsum4", "[", "coeff4", "]"}]}], "]"}]}]}], "/.", 
                RowBox[{"{", 
                 RowBox[{"x", "->", 
                  SqrtBox[
                   RowBox[{"2", "i"}]]}], "}"}]}], "]"}]}], ")"}], ")"}]}], 
          "}"}], ",", 
