          RowBox[{"1", "->", "1"}], ",", 
          RowBox[{"2", "->", "1"}], ",", 
          RowBox[{"3", "->", "1"}], ",", 
          RowBox[{"4", "->", "2"}]}], "|>"}]}], "}"}]}], "}"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.9920819341058407`*^9, 3.992082142409998*^9}, {
   3.992413998710218*^9, 3.9924143338637342`*^9}, {3.992454945860623*^9, 
