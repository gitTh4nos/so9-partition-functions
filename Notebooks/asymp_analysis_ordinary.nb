             RowBox[{
              RowBox[{"WeylChar", "[", "rep", "]"}], "/.", "yxsub"}], ")"}]}],
            "//", "Expand"}], ")"}], "/.", "xrule"}], "//", "Simplify"}]}], 
      "}"}], ",", 
     RowBox[{"{", 
