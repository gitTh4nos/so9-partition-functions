Cell[CellGroupData[{

Cell["2nd Rademacher for several reps", "Subsection",
 CellChangeTimes->{{3.994951369866186*^9, 
  3.9949513794482307`*^9}},ExpressionUUID->"06d176d6-83a1-49d6-86c1-\
17822383487a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"replist", "=", 
   RowBox[{"Take", "[", 
    RowBox[{
     RowBox[{"Sort", "[", 
      RowBox[{
       RowBox[{"getreplistord", "[", "20", "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Dimrep", "[", "#1", "]"}], "<", 
         RowBox[{"Dimrep", "[", "#2", "]"}]}], "&"}]}], "]"}], ",", "50"}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.994856219132605*^9, 3.9948562348650293`*^9}, {
   3.994856409697577*^9, 3.994856544346821*^9}, 3.994940630280423*^9, {
   3.994943378186432*^9, 3.994943381299633*^9}, {3.9958980949552927`*^9, 
   3.995898102476857*^9}},
 CellLabel->"In[91]:=",ExpressionUUID->"229da50a-f14b-4bec-9bd7-06ab2ee10432"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Nlevel", "=", "150"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"N2level", "=", "200"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"max", "=", "200"}], ";"}]}], "Input",
 CellChangeTimes->{{3.994951586013563*^9, 3.994951618520877*^9}, {
  3.9950025683571033`*^9, 3.995002568679699*^9}, {3.995002623756572*^9, 
  3.99500262435048*^9}},
 CellLabel->"In[92]:=",ExpressionUUID->"cb207f2a-ce98-4e35-83ce-02e54ead201f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"rep", "=", 
       RowBox[{"replist", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"coeffT", "=", 
       RowBox[{
        RowBox[{"coefflist", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Transpose", "[", "coefflist", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", "rep"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"coeff2", "=", 
       RowBox[{"coeff2list", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Transpose", "[", "coeff2list", "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", "rep"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Representation \>\"", "<>", 
        RowBox[{"ToString", "[", "rep", "]"}]}], "]"}], ";", 
      RowBox[{"rad12list", "=", 
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"(", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"data", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "[", "rep", "]"}], "-", 
              RowBox[{"Round", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Repsum1", "[", 
                  RowBox[{"x", ",", "coeffT"}], "]"}], "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"-", "I"}], ")"}], 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], "^", "i"}], " ", 
                  RowBox[{"Repsum2", "[", "coeff2", "]"}]}]}], "/.", 
                RowBox[{"{", 
                 RowBox[{"x", "->", 
                  SqrtBox[
                   RowBox[{"2", "i"}]]}], "}"}]}], "]"}]}], ")"}], ")"}]}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "3", ",", "max"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"Show", "[", 
        RowBox[{"ListPlot", "[", "rad12list", "]"}], "]"}], "]"}], ";"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Length", "[", "replist", "]"}]}], "}"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.994860134839306*^9, 3.994860167660606*^9}, {
  3.99486019794158*^9, 3.994860290491384*^9}, {3.994865572046846*^9, 
  3.994865579220632*^9}, {3.994951746025283*^9, 3.9949518161341047`*^9}, {
  3.994952905825886*^9, 3.994953039260105*^9}, {3.9949530723000793`*^9, 
  3.994953101197358*^9}, {3.994953150158998*^9, 3.9949531677391863`*^9}, {
  3.9949532680756474`*^9, 3.994953270866745*^9}, {3.994953602661799*^9, 
  3.9949536469862127`*^9}, {3.994953739354834*^9, 3.9949537397541857`*^9}, {
  3.994953791927346*^9, 3.994953793722032*^9}},
 CellLabel->"In[95]:=",ExpressionUUID->"8ccf114e-e0ee-45b8-b159-f980ef7ce270"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Third Rademacher", "Section",
 CellChangeTimes->{{3.986401113492135*^9, 3.986401117332183*^9}, {
  3.9916703482243843`*^9, 
  3.99167034908997*^9}},ExpressionUUID->"3b3cc812-072a-4d4a-a625-\
0eaa60c5f0fc"],

Cell["\<\
The third Rademacher term comes from \
(\[Omega]1,\[Omega]2,\[Omega]3,\[Omega]4)=(0,0,0,0),(0,0,2\[Pi]/3), \
(0,0,\[Pi]/3,\[Pi]/3),(0,\[Pi]/3,\[Pi]/3,2\[Pi]/3),(\[Pi]/3,\[Pi]/3,\[Pi]/3,\
\[Pi]/3) plus permutations and shifts by +/- \[Pi] that keep \[Omega]1+\
\[Omega]2+\[Omega]3+\[Omega]4 =2 n/3 \[Pi].  This give 5 distinct terms.\
\>", "Text",
 CellChangeTimes->{{3.992525132382379*^9, 3.9925255593223953`*^9}, {
  3.99252565488382*^9, 
  3.992525663211967*^9}},ExpressionUUID->"a36fd5d1-ffca-42b2-8794-\
193685d9d0c1"],

Cell[CellGroupData[{

Cell["\<\
Generate t3-functions for many reps [Only  run this if you want a new set of \
coefficient lists]\
\>", "Subsection",
 CellChangeTimes->{{3.994855554001539*^9, 3.9948555605560417`*^9}, {
   3.994856081925302*^9, 3.994856090068844*^9}, {3.994856212280854*^9, 
