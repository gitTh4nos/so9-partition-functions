    RowBox[{"(", "9", ")"}], " ", "Weyl", " ", "character"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"WeylChar", "[", "rep_List", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"hw", ",", "hwv", ",", "pwv", ",", "pwt", ",", "ID"}], "}"}], ",", 
      RowBox[{
       RowBox[{"hw", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"rep", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "+", 
           RowBox[{"rep", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "+", 
           RowBox[{"rep", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "+", 
           RowBox[{
            RowBox[{"rep", "[", 
             RowBox[{"[", "4", "]"}], "]"}], "/", "2"}]}], ",", 
          RowBox[{
           RowBox[{"rep", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "+", 
           RowBox[{"rep", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "+", 
           RowBox[{
            RowBox[{"rep", "[", 
             RowBox[{"[", "4", "]"}], "]"}], "/", "2"}]}], ",", 
