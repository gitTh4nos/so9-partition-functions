              RowBox[{"2", 
               RowBox[{"(", "maxlevel", ")"}]}]]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{
              RowBox[{"Log", "[", 
               RowBox[{
                RowBox[{"data", "[", 
                 RowBox[{"[", "maxlevel", "]"}], "]"}], "[", "rep", "]"}], 
               "]"}], "+", "1"}]}], "}"}]}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
