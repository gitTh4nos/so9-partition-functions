509d2fcde524"],

Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"tcompute", "[", 
      RowBox[{"[", "3", "]"}], "]"}], "||", 
     RowBox[{"cocompute", "[", 
      RowBox[{"[", "3", "]"}], "]"}]}], ",", 
    RowBox[{"replist", "=", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Take", "[", 
        RowBox[{
         RowBox[{"Sort", "[", 
          RowBox[{
           RowBox[{"getreplistord", "[", "20", "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Dimrep", "[", "#1", "]"}], "<", 
             RowBox[{"Dimrep", "[", "#2", "]"}]}], "&"}]}], "]"}], ",", 
         "10"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "<", "3"}], "&"}]}], "]"}]}]}], 
   "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.994856219132605*^9, 3.9948562348650293`*^9}, {
   3.994856409697577*^9, 3.994856544346821*^9}, 3.994940630280423*^9, {
