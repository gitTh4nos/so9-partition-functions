Cell[BoxData[
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"tcompute", "[", 
     RowBox[{"[", "4", "]"}], "]"}], "||", 
    RowBox[{"cocompute", "[", 
     RowBox[{"[", "4", "]"}], "]"}]}], ",", 
   RowBox[{
    RowBox[{"replist", "=", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Take", "[", 
        RowBox[{
         RowBox[{"Sort", "[", 
          RowBox[{
           RowBox[{"getreplistord", "[", "20", "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Dimrep", "[", "#1", "]"}], "<", 
             RowBox[{"Dimrep", "[", "#2", "]"}]}], "&"}]}], "]"}], ",", 
         "10"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "<", "3"}], "&"}]}], "]"}]}], 
    ";"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.994856219132605*^9, 3.9948562348650293`*^9}, {
   3.994856409697577*^9, 3.994856544346821*^9}, 3.994940630280423*^9, {
   3.994943378186432*^9, 3.994943381299633*^9}, {3.994954035313572*^9, 
   3.994954035632771*^9}, 3.9949545082003*^9, 3.9949556912615433`*^9, {
   3.994961451750161*^9, 3.9949614528890038`*^9}, 3.99497110502693*^9, {
   3.995002796509283*^9, 3.995002796750578*^9}, 3.995006411605318*^9, {
