        RowBox[{
         RowBox[{
          RowBox[{"ID", "=", 
           RowBox[{"IntegerDigits", "[", 
            RowBox[{"n", ",", "2"}], "]"}]}], ";", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{"ID", "=", 
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"{", "0", "}"}], ",", "ID"}], "]"}]}], ",", 
            RowBox[{"{", 
