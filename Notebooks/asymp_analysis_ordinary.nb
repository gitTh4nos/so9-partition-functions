Cell[CellGroupData[{

Cell["3rd Rademacher for many reps", "Subsection",
 CellChangeTimes->{{3.994855554001539*^9, 3.9948555605560417`*^9}, {
   3.994856081925302*^9, 3.994856090068844*^9}, {3.994856212280854*^9, 
   3.994856216007722*^9}, {3.994858795270269*^9, 3.994858815724926*^9}, 
