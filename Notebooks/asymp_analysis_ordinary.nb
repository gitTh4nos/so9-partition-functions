Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Measurexc", "[", 
    RowBox[{"c_", ",", "n_List"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"384", " ", "16"}]], 
    RowBox[{"Product", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "[", "i", "]"}], 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"n", "[", 
             RowBox[{"[", "i", "]"}], "]"}], 
            RowBox[{"\[Pi]", "/", "c"}]}], "]"}]}], "-", 
         RowBox[{
          RowBox[{"1", "/", 
           RowBox[{"x", "[", "i", "]"}]}], 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "I"}], " ", 
            RowBox[{"n", "[", 
             RowBox[{"[", "i", "]"}], "]"}], 
            RowBox[{"\[Pi]", "/", "c"}]}], "]"}]}]}], ")"}], "^", "3"}], ",", 
      
      RowBox[{"{", 
       RowBox[{"i", ",", "4"}], "}"}]}], "]"}], 
    RowBox[{"Product", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"x", "[", "i", "]"}], 
           RowBox[{"x", "[", "j", "]"}], 
           RowBox[{"Exp", "[", 
            RowBox[{"I", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"n", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "+", 
               RowBox[{"n", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], ")"}], 
             RowBox[{"\[Pi]", "/", "c"}]}], "]"}]}], "-", 
          RowBox[{
           RowBox[{"1", "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"x", "[", "i", "]"}], 
              RowBox[{"x", "[", "j", "]"}]}], ")"}]}], 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "I"}], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"n", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "+", 
               RowBox[{"n", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], ")"}], 
             RowBox[{"\[Pi]", "/", "c"}]}], "]"}]}]}], ")"}], "^", "2"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"x", "[", "i", "]"}], "/", 
            RowBox[{"x", "[", "j", "]"}]}], 
           RowBox[{"Exp", "[", 
            RowBox[{"I", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"n", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "-", 
               RowBox[{"n", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], ")"}], 
             RowBox[{"\[Pi]", "/", "c"}]}], "]"}]}], "-", 
          RowBox[{
           RowBox[{
            RowBox[{"x", "[", "j", "]"}], "/", 
            RowBox[{"x", "[", "i", "]"}]}], 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "I"}], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"n", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "-", 
               RowBox[{"n", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], ")"}], 
             RowBox[{"\[Pi]", "/", "c"}]}], "]"}]}]}], ")"}], "^", "2"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", 
        RowBox[{"i", "+", "1"}], ",", "4"}], "}"}]}], "]"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9949313337847967`*^9, 3.994931545170662*^9}, {
