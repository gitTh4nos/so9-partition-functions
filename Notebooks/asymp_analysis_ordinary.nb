 CellLabel->"In[96]:=",ExpressionUUID->"26e8dade-2cd3-493d-954f-01a1a77ae5d9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"coeff3array", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"8", ",", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"1", "->", "0"}], ",", 
         RowBox[{"2", "->", "0"}], ",", 
         RowBox[{"3", "->", "0"}], ",", 
         RowBox[{"4", "->", "0"}]}], "|>"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"4", " ", "4", " ", 
        RowBox[{
         SuperscriptBox["2", "3"], "/", "2"}]}], ",", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"1", "->", "2"}], ",", 
         RowBox[{"2", "->", "0"}], ",", 
         RowBox[{"3", "->", "0"}], ",", 
         RowBox[{"4", "->", "0"}]}], "|>"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"6", " ", 
        SuperscriptBox["4", "2"], " ", 
        RowBox[{
         SuperscriptBox["2", "2"], "/", "2"}]}], ",", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"1", "->", "1"}], ",", 
         RowBox[{"2", "->", "1"}], ",", 
         RowBox[{"3", "->", "0"}], ",", 
         RowBox[{"4", "->", "0"}]}], "|>"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"4", " ", 
        SuperscriptBox["4", "3"], " ", 
        RowBox[{"2", "/", "2"}]}], ",", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"1", "->", "1"}], ",", 
         RowBox[{"2", "->", "1"}], ",", 
         RowBox[{"3", "->", "2"}], ",", 
         RowBox[{"4", "->", "0"}]}], "|>"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SuperscriptBox["4", "4"], "/", "2"}], ",", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"1", "->", "1"}], ",", 
         RowBox[{"2", "->", "1"}], ",", 
         RowBox[{"3", "->", "1"}], ",", 
         RowBox[{"4", "->", "1"}]}], "|>"}]}], "}"}]}], "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.994954092804555*^9, 3.994954189950732*^9}, 
   3.994954249983124*^9, {3.995004190886468*^9, 3.995004192839739*^9}},
 CellLabel->"In[97]:=",ExpressionUUID->"67ff88aa-e337-4f82-8d18-ed78e746baa2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"t3functionstemp", "=", 
   RowBox[{"Monitor", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"na", "=", 
         RowBox[{"coeff3array", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ";", 
        RowBox[{"ParallelTable", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"rep", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"coeff3array", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], "Measurex", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"WeylChar", "[", "rep", "]"}], "/.", "yxsub"}], 
                   ")"}]}], "/.", 
                 RowBox[{"xsubc", "[", "3", "]"}]}], "//", "Expand"}], ")"}], 
              "/.", 
              RowBox[{"xruleac", "[", 
               RowBox[{
                RowBox[{"-", "1"}], ",", "3"}], "]"}]}], "//", "Simplify"}]}],
            "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"rep", ",", "replist"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "coeff3array", "]"}]}], "}"}]}], "]"}], ",", 
     "i"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.994856123985586*^9, 3.994856144665017*^9}, {
   3.9948566085280237`*^9, 3.9948566925699863`*^9}, {3.994857884813691*^9, 
   3.994857897771323*^9}, 3.994940654088127*^9, {3.994941026621129*^9, 
   3.9949410401533537`*^9}, {3.9949410805997143`*^9, 3.994941090139263*^9}, 
   3.994942297674238*^9, {3.994943038124527*^9, 3.994943069204781*^9}, {
   3.99494312322943*^9, 3.994943134508287*^9}, {3.994954276039466*^9, 
   3.994954293108942*^9}, {3.99495433119128*^9, 3.994954413792684*^9}, {
   3.9949544468468246`*^9, 3.994954492816216*^9}, {3.994954616145533*^9, 
   3.9949546283295593`*^9}, {3.994954757711176*^9, 3.994954793793728*^9}, {
   3.994955557139896*^9, 3.994955557821034*^9}, {3.994955642450898*^9, 
   3.994955675674304*^9}, {3.994955730222485*^9, 3.9949557574486303`*^9}, {
