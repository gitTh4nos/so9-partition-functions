Cell[BoxData[
 RowBox[{
  RowBox[{"coeff4list", "=", 
   RowBox[{"Monitor", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"t4functions", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}], "}"}], ",", 
         RowBox[{"ParallelTable", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"CoefficientList", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Normal", "[", 
                RowBox[{"Series", "[", 
                 RowBox[{
                  RowBox[{"t4functions", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", 
                    RowBox[{"j", "+", "1"}]}], "]"}], "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"t", ",", "0", ",", 
                    RowBox[{"6", "+", "N4level"}]}], "}"}]}], "]"}], "]"}], "/", 
               RowBox[{"t", "^", 
                RowBox[{"(", 
                 RowBox[{"power4", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], ")"}]}]}], ",", "t"}], 
             "]"}], "//", "Simplify"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "6"}], "}"}]}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "t4functions", "]"}]}], "}"}]}], "]"}], ",", 
     "i"}], "]"}]}], ";"}]], "Input",
