Cell[CellGroupData[{

Cell["Third Rademacher", "Section",
 CellChangeTimes->{{3.986401113492135*^9, 3.986401117332183*^9}, {
  3.9916703482243843`*^9, 
  3.99167034908997*^9}},ExpressionUUID->"3b3cc812-072a-4d4a-a625-\
0eaa60c5f0fc"],

Cell["\<\
The third Rademacher term comes from \
(\[Omega]1,\[Omega]2,\[Omega]3,\[Omega]4)=(0,0,0,0),(0,0,2\[Pi]/3), \
(0,0,\[Pi]/3,\[Pi]/3),(0,\[Pi]/3,\[Pi]/3,2\[Pi]/3),(\[Pi]/3,\[Pi]/3,\[Pi]/3,\
\[Pi]/3) plus permutations and shifts by +/- \[Pi] that keep \[Omega]1+\
\[Omega]2+\[Omega]3+\[Omega]4 =2 n/3 \[Pi].  This give 5 distinct terms.\
\>", "Text",
 CellChangeTimes->{{3.992525132382379*^9, 3.9925255593223953`*^9}, {
  3.99252565488382*^9, 
  3.992525663211967*^9}},ExpressionUUID->"a36fd5d1-ffca-42b2-8794-\
193685d9d0c1"],

Cell[CellGroupData[{

Cell["\<\
Generate t3-functions for many reps [Only  run this if you want a new set of \
coefficient lists]\
\>", "Subsection",
 CellChangeTimes->{{3.994855554001539*^9, 3.9948555605560417`*^9}, {
   3.994856081925302*^9, 3.994856090068844*^9}, {3.994856212280854*^9, 
