Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"rep", "=", 
       RowBox[{"replist", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"coeffT", "=", 
       RowBox[{
        RowBox[{"coefflist", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Transpose", "[", "coefflist", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", "rep"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"coeff2", "=", 
       RowBox[{"coeff2list", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Transpose", "[", "coeff2list", "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", "rep"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
      RowBox[{"coeff3", "=", 
       RowBox[{"coeff3list", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Transpose", "[", "coeff3list", "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", "rep"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Representation \>\"", "<>", 
        RowBox[{"ToString", "[", "rep", "]"}]}], "]"}], ";", 
      RowBox[{"rad123list", "=", 
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"(", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"data", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "[", "rep", "]"}], "-", 
              RowBox[{"Round", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Repsum1", "[", 
                  RowBox[{"x", ",", "coeffT"}], "]"}], "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"-", "I"}], ")"}], 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], "^", "i"}], " ", 
                  RowBox[{"Repsum2", "[", "coeff2", "]"}]}], "+", 
                 RowBox[{"2", 
                  RowBox[{"Re", "[", 
                   RowBox[{
                    RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"-", "2"}], 
                    RowBox[{"\[Pi]", "/", "3"}], 
                    RowBox[{"(", 
                    RowBox[{"i", "+", "1"}], ")"}], "I"}], "]"}], 
                    RowBox[{"Repsum3", "[", "coeff3", "]"}]}], "]"}]}]}], "/.", 
                RowBox[{"{", 
                 RowBox[{"x", "->", 
                  SqrtBox[
                   RowBox[{"2", "i"}]]}], "}"}]}], "]"}]}], ")"}], ")"}]}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "3", ",", "max"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"Show", "[", 
        RowBox[{"ListPlot", "[", "rad123list", "]"}], "]"}], "]"}], ";"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Length", "[", "replist", "]"}]}], "}"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.994860134839306*^9, 3.994860167660606*^9}, {
   3.99486019794158*^9, 3.994860290491384*^9}, {3.994865572046846*^9, 
