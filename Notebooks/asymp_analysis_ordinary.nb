     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"tfunctions", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
         RowBox[{"CoefficientList", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Normal", "[", 
             RowBox[{"Series", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"tfunctions", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "2"}], "]"}], "]"}], "/", 
                RowBox[{"t", "^", "36"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"t", ",", "0", ",", 
                 RowBox[{"36", "+", 
                  RowBox[{"2", "Nlevel"}]}]}], "}"}]}], "]"}], "]"}], "/.", 
            RowBox[{"{", 
             RowBox[{"t", "->", 
              RowBox[{"x", "^", 
               RowBox[{"(", 
                RowBox[{"1", "/", "2"}], ")"}]}]}], "}"}]}], ",", "x"}], 
          "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "tfunctions", "]"}]}], "}"}]}], "]"}]}], ";", 
    
    RowBox[{"Export", "[", 
