Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"xruleac", "[", 
    RowBox[{"a_", ",", "c_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"x", "[", "i_", "]"}], "^", 
       RowBox[{"(", "m_", ")"}]}], ":>", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        RowBox[{"1", "+", 
         RowBox[{"Floor", "[", 
          RowBox[{"a", " ", 
           RowBox[{
            RowBox[{"na", "[", "i", "]"}], "/", "c"}]}], "]"}]}]], 
       FractionBox[
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "m"}], " ", "\[Pi]", " ", "t"}], "]"}], 
         RowBox[{"Exp", "[", 
          RowBox[{"m", " ", 
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"na", "[", "i", "]"}], "a"}], " ", ",", "c"}], "]"}], 
           "\[Pi]", " ", 
           RowBox[{"t", "/", "c"}]}], "]"}]}], 
        RowBox[{"1", "+", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "m"}], " ", "\[Pi]", " ", "t"}], "]"}]}]]}]}], ",", 
     RowBox[{
      RowBox[{"x", "[", "i_", "]"}], ":>", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        RowBox[{"1", "+", 
         RowBox[{"Floor", "[", 
          RowBox[{"a", " ", 
           RowBox[{
            RowBox[{"na", "[", "i", "]"}], "/", "c"}]}], "]"}]}]], 
       FractionBox[
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", " ", "\[Pi]"}], " ", "t"}], "]"}], 
         RowBox[{"Exp", "[", " ", 
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"na", "[", "i", "]"}], "a"}], " ", ",", "c"}], "]"}], 
           "\[Pi]", " ", 
           RowBox[{"t", "/", "c"}]}], "]"}]}], 
        RowBox[{"1", "+", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", " ", "\[Pi]"}], " ", "t"}], "]"}]}]]}]}]}], "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.995126476015174*^9, 3.995126531401163*^9}, {
  3.99512700821471*^9, 3.9951270816954193`*^9}, {3.995127128612402*^9, 
