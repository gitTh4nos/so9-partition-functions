   "Get", " ", "the", " ", "50", " ", "smallest", " ", "dimension", " ", 
    "reps"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"tcompute", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "||", 
      RowBox[{"cocompute", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", 
     RowBox[{"replist", "=", 
      RowBox[{"Take", "[", 
       RowBox[{
        RowBox[{"Sort", "[", 
         RowBox[{
          RowBox[{"getreplistord", "[", "20", "]"}], ",", 
          RowBox[{
