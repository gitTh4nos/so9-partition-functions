Cell[BoxData[
 RowBox[{
  RowBox[{"Measurex", "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"384", " ", "16"}]], 
    RowBox[{"Product", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"x", "[", "i", "]"}], "-", 
         RowBox[{"1", "/", 
          RowBox[{"x", "[", "i", "]"}]}]}], ")"}], "^", "3"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "4"}], "}"}]}], "]"}], 
    RowBox[{"Product", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"x", "[", "i", "]"}], 
           RowBox[{"x", "[", "j", "]"}]}], "-", 
          RowBox[{"1", "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"x", "[", "i", "]"}], 
             RowBox[{"x", "[", "j", "]"}]}], ")"}]}]}], ")"}], "^", "2"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"x", "[", "i", "]"}], "/", 
           RowBox[{"x", "[", "j", "]"}]}], "-", 
          RowBox[{
           RowBox[{"x", "[", "j", "]"}], "/", 
           RowBox[{"x", "[", "i", "]"}]}]}], ")"}], "^", "2"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", 
        RowBox[{"i", "+", "1"}], ",", "4"}], "}"}]}], "]"}]}]}], 
  ";"}]], "Input",
