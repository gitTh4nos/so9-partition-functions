            RowBox[{"Dimrep", "[", "#1", "]"}], "<", 
            RowBox[{"Dimrep", "[", "#2", "]"}]}], "&"}]}], "]"}], ",", "50"}],
        "]"}]}]}], "]"}], ";"}]}]], "Input",
