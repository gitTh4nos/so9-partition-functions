               RowBox[{"{", "0", "}"}], ",", "ID"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", 
              RowBox[{"4", "-", 
               RowBox[{"Length", "[", 
                RowBox[{"IntegerDigits", "[", 
