Cell[BoxData[
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"tcompute", "[", 
    RowBox[{"[", "4", "]"}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"List", " ", "of", " ", "shifts", " ", 
     RowBox[{"(", "second", ")"}], " ", "and", " ", "the", " ", "degeneracy", 
     " ", "for", " ", "each", " ", "shift", " ", 
     RowBox[{"(", "first", ")"}]}], "*)"}], 
   RowBox[{
    RowBox[{"coeff4array", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"4", " ", "4", " ", 
          SuperscriptBox["2", "3"]}], ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"1", "->", "1"}], ",", 
           RowBox[{"2", "->", "0"}], ",", 
           RowBox[{"3", "->", "0"}], ",", 
           RowBox[{"4", "->", "0"}]}], "|>"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"4", " ", 
          SuperscriptBox["4", "3"], "2"}], ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"1", "->", "1"}], ",", 
           RowBox[{"2", "->", "1"}], ",", 
           RowBox[{"3", "->", "1"}], ",", 
           RowBox[{"4", "->", "0"}]}], "|>"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"12", " ", "4", " ", "2", " ", 
          RowBox[{"2", "^", "2"}]}], ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"1", "->", "1"}], ",", 
           RowBox[{"2", "->", "2"}], ",", 
           RowBox[{"3", "->", "0"}], ",", 
           RowBox[{"4", "->", "0"}]}], "|>"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"12", " ", "4", " ", 
          SuperscriptBox["2", "2"], "2"}], ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"1", "->", "1"}], ",", 
           RowBox[{"2", "->", "2"}], ",", 
           RowBox[{"3", "->", "2"}], ",", 
           RowBox[{"4", "->", "0"}]}], "|>"}]}], "\[IndentingNewLine]", "}"}],
        ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"4", " ", "4", " ", 
          SuperscriptBox["2", "3"]}], ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"1", "->", "1"}], ",", 
           RowBox[{"2", "->", "2"}], ",", 
           RowBox[{"3", "->", "2"}], ",", 
           RowBox[{"4", "->", "2"}]}], "|>"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"4", " ", 
          SuperscriptBox["4", "3"], "2"}], ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"1", "->", "1"}], ",", 
           RowBox[{"2", "->", "1"}], ",", 
           RowBox[{"3", "->", "1"}], ",", 
           RowBox[{"4", "->", "2"}]}], "|>"}]}], "}"}]}], "}"}]}], ";", 
    RowBox[{"t4functionstemp", "=", 
     RowBox[{"Monitor", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"na", "=", 
           RowBox[{"coeff4array", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ";", 
          RowBox[{"ParallelTable", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"rep", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"coeff4array", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], "Measurex", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"WeylChar", "[", "rep", "]"}], "/.", "yxsub"}], 
                    ")"}]}], "/.", 
                   RowBox[{"xsubc", "[", "4", "]"}]}], "//", "Expand"}], 
                 ")"}], "/.", 
                RowBox[{"xruleac", "[", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", "4"}], "]"}]}], "//", 
               "Simplify"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"rep", ",", "replist"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "coeff4array", "]"}]}], "}"}]}], "]"}], ",",
        "i"}], "]"}]}], ";", 
    RowBox[{"Export", "[", 
     RowBox[{"\"\<t4functions.m\>\"", ",", 
      RowBox[{"Compress", "[", "t4functions", "]"}]}], "]"}], ";"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9920819341058407`*^9, 3.992082142409998*^9}, {
   3.992413998710218*^9, 3.9924143338637342`*^9}, {3.992454945860623*^9, 
   3.992454949939797*^9}, {3.9924574388768473`*^9, 3.992457443375457*^9}, {
   3.992457535290884*^9, 3.992457543225142*^9}, {3.9925335535889807`*^9, 
   3.992533571985291*^9}, 3.992535406428954*^9, {3.992535436523058*^9, 
   3.992535437717005*^9}, {3.9950071589761133`*^9, 3.995007220917348*^9}, {
   3.995007252289116*^9, 3.995007308920085*^9}, {3.995984065755282*^9, 
   3.995984083272031*^9}, {3.995984113902481*^9, 
   3.9959841539203568`*^9}},ExpressionUUID->"c1807132-2377-4016-b52d-\
cc25e87d44db"],

Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"cocompute", "[", 
     RowBox[{"[", "4", "]"}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "Starting", " ", "powers", " ", "for", " ", "the", " ", "6", " ", 
      "classes", " ", "of", " ", "peaks"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"power4", "=", 
      RowBox[{"{", 
       RowBox[{"21", ",", "9", ",", "10", ",", "7", ",", "12", ",", "6"}], 
       "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"N4level", "=", "150"}], ";", 
     RowBox[{"coeff4list", "=", 
      RowBox[{"Monitor", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"t4functions", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "1"}], "]"}], "]"}], "}"}], ",", 
            RowBox[{"ParallelTable", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"CoefficientList", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Normal", "[", 
                   RowBox[{"Series", "[", 
                    RowBox[{
                    RowBox[{"t4functions", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", 
                    RowBox[{"j", "+", "1"}]}], "]"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"t", ",", "0", ",", 
                    RowBox[{"6", "+", "N4level"}]}], "}"}]}], "]"}], "]"}], "/", 
                  RowBox[{"t", "^", 
                   RowBox[{"(", 
                    RowBox[{"power4", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], ")"}]}]}], ",", "t"}], 
                "]"}], "//", "Simplify"}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "6"}], "}"}]}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "t4functions", "]"}]}], "}"}]}], "]"}], ",",
         "i"}], "]"}]}], ";", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{"\"\<coeff4list\>\"", "<>", 
        RowBox[{"ToString", "[", "N4level", "]"}], "<>", "\"\<.m\>\""}], ",", 
       
       RowBox[{"Compress", "[", "coeff4list", "]"}]}], "]"}]}]}], "]"}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.994968853779441*^9, 3.994968856482808*^9}, 
   3.994970089583894*^9, {3.995005889580501*^9, 3.995005891327853*^9}, {
