          RowBox[{"i", ",", "4"}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"t21functions", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"64", "Measurex", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"WeylChar", "[", "rep", "]"}], "/.", "yxsub"}], 
               ")"}]}], "/.", 
             RowBox[{"xsubc", "[", "2", "]"}]}], "//", "Expand"}], ")"}], "/.", 
          RowBox[{"xruleac", "[", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "2"}], "]"}]}], "//", "Simplify"}], ",", 
        
        RowBox[{"{", 
         RowBox[{"rep", ",", "replist"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nn", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1", ",", "0"}], "}"}]}], ";", 
     RowBox[{"na", "=", 
      RowBox[{"Association", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"i", "->", 
          RowBox[{"nn", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "4"}], "}"}]}], "]"}], "]"}]}], ";", 
     RowBox[{"t22functions", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"64", "Measurex", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"WeylChar", "[", "rep", "]"}], "/.", "yxsub"}], 
               ")"}]}], "/.", 
             RowBox[{"xsubc", "[", "2", "]"}]}], "//", "Expand"}], ")"}], "/.", 
          RowBox[{"xruleac", "[", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "2"}], "]"}]}], "//", "Simplify"}], ",", 
        
        RowBox[{"{", 
         RowBox[{"rep", ",", "replist"}], "}"}]}], "]"}]}], ";", 
     RowBox[{"t2functions", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"replist", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", 
          RowBox[{"t21functions", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", 
          RowBox[{"t22functions", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
