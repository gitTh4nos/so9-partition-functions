Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Difference", " ", "between", " ", "actual", " ", "multiplicity", " ", 
    "and", " ", "Rademacher", " ", "approximation", " ", "up", " ", "to", " ",
     "5", "th", " ", 
    RowBox[{"order", "."}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"max", "=", "110"}], ";", 
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"rep", "=", 
        RowBox[{"replist", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"coeffT", "=", 
        RowBox[{
         RowBox[{"coefflist", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Transpose", "[", "coefflist", "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", "rep"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"coeff2", "=", 
        RowBox[{"coeff2list", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"Position", "[", 
