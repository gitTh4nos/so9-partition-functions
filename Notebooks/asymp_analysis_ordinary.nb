Cell[BoxData[
 RowBox[{
  RowBox[{"replist", "=", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{
         RowBox[{"getreplistord", "[", "20", "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Dimrep", "[", "#1", "]"}], "<", 
           RowBox[{"Dimrep", "[", "#2", "]"}]}], "&"}]}], "]"}], ",", "10"}], 
      "]"}], ",", 
     RowBox[{
      RowBox[{
