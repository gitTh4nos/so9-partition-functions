bbc5e0650b2c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"coeff3list", "=", 
   RowBox[{"Monitor", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"t3functions", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}], "}"}], ",", 
         RowBox[{"ParallelTable", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"CoefficientList", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Normal", "[", 
                RowBox[{"Series", "[", 
                 RowBox[{
                  RowBox[{"t3functions", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", 
                    RowBox[{"j", "+", "1"}]}], "]"}], "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"t", ",", "0", ",", 
                    RowBox[{"9", "+", "N3level"}]}], "}"}]}], "]"}], "]"}], "/", 
               RowBox[{"t", "^", 
                RowBox[{"(", 
                 RowBox[{"power3", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], ")"}]}]}], ",", "t"}], 
             "]"}], "//", "Simplify"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "5"}], "}"}]}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "t3functions", "]"}]}], "}"}]}], "]"}], ",", 
     "i"}], "]"}]}], ";"}]], "Input",
