Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Compute", " ", "dimension", " ", "of", " ", "SO", 
    RowBox[{"(", "9", ")"}], " ", "rep"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Dimrep", "[", "rep_List", "]"}], ":=", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"w", ",", "g", ",", "p", ",", "q", ",", "r", ",", "s"}], "}"}],
       ",", 
      RowBox[{
       RowBox[{"p", "=", 
        RowBox[{"rep", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", 
       RowBox[{"q", "=", 
        RowBox[{"rep", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", 
       RowBox[{"r", "=", 
        RowBox[{"rep", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ";", 
       RowBox[{"s", "=", 
        RowBox[{"rep", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], ";", 
       RowBox[{"w", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"p", "+", "q", "+", "r", "+", 
           RowBox[{"s", "/", "2"}]}], ",", 
          RowBox[{"q", "+", "r", "+", 
           RowBox[{"s", "/", "2"}]}], ",", 
          RowBox[{"r", "+", 
           RowBox[{"s", "/", "2"}]}], ",", 
          RowBox[{"s", "/", "2"}]}], "}"}]}], ";", 
       RowBox[{"g", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"9", "/", "2"}], "-", "i"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "4"}], "}"}]}], "]"}]}], ";", 
       RowBox[{
        RowBox[{"Product", "[", 
         RowBox[{
          FractionBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"w", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "+", 
             RowBox[{"g", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], ")"}], 
           RowBox[{"g", "[", 
            RowBox[{"[", "i", "]"}], "]"}]], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "4"}], "}"}]}], "]"}], 
        RowBox[{"Product", "[", 
         RowBox[{
          FractionBox[
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"w", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "+", 
               RowBox[{"g", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "^", "2"}], "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"w", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "+", 
               RowBox[{"g", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "^", "2"}]}], 
           RowBox[{
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "^", "2"}], "-", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "^", "2"}]}]], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"i", "+", "1"}], ",", "4"}], "}"}]}], "]"}]}]}]}], "]"}], 
    "[", 
    RowBox[{"[", "1", "]"}], "]"}]}]}]], "Input",
