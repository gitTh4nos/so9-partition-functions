 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Result", " ", "of", " ", "Inverse", " ", "Laplace", " ", "transform"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"BIa", "[", 
