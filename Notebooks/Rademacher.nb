Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Takes", " ", "info", " ", "from", " ", "bsols", " ", "to", " ", "turn", 
    " ", "into", " ", "log", " ", "plots", " ", "for", " ", "a", " ", "given",
     " ", "representation"}], "*)"}], 
  RowBox[{
   RowBox[{"bvals", "[", "rep_List", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", ",", "q", ",", "r", ",", "s", ",", "temp"}], "}"}], ",", 
     RowBox[{
      RowBox[{"p", "=", 
       RowBox[{"rep", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", 
      RowBox[{"q", "=", 
       RowBox[{"rep", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", 
      RowBox[{"r", "=", 
       RowBox[{"rep", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], ";", 
      RowBox[{"s", "=", 
       RowBox[{"rep", "[", 
        RowBox[{"[", "4", "]"}], "]"}]}], ";", 
      RowBox[{"temp", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           SqrtBox[
            RowBox[{"2", 
             RowBox[{"(", 
              RowBox[{"i", "+", "1"}], ")"}]}]], ",", 
           RowBox[{
            RowBox[{"Log", "[", 
             SubscriptBox["b", 
              RowBox[{"p", ",", "q", ",", "r", ",", "s"}]], "]"}], "/.", 
            RowBox[{"bsols", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", 
           RowBox[{"Length", "[", "bsols", "]"}]}], "}"}]}], "]"}]}], ";", 
      RowBox[{"temp", "=", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{"temp", ",", 
         RowBox[{"{", 
          RowBox[{"n_", ",", 
           RowBox[{"Log", "[", 
            SubscriptBox["b", 
             RowBox[{"m_", ",", "l_", ",", "k_", ",", "j_"}]], "]"}]}], 
          "}"}]}], "]"}]}]}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.982234367211933*^9, 3.982234450441449*^9}, {
