Cell[BoxData[
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"rep", "=", 
      RowBox[{"replist", "[", 
       RowBox[{"[", "i", "]"}], "]"}]}], ";", 
     RowBox[{"posrep", "=", 
      RowBox[{
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Transpose", "[", "coefflist", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", "rep"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"logdata", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          SqrtBox[
           RowBox[{"2", 
            RowBox[{"(", 
             RowBox[{"j", "+", "1"}], ")"}]}]], ",", 
          RowBox[{"Log", "[", 
           RowBox[{
            RowBox[{"data", "[", 
             RowBox[{"[", "j", "]"}], "]"}], "[", "rep", "]"}], "]"}]}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "maxlevel"}], "}"}]}], "]"}]}], ";", 
     RowBox[{"bplot", "=", 
      RowBox[{"ListPlot", "[", 
       RowBox[{"logdata", ",", 
        RowBox[{"PlotStyle", "->", "Red"}], ",", 
        RowBox[{"AxesLabel", "->", 
         RowBox[{"{", 
          
          RowBox[{"\"\<\!\(\*SqrtBox[\(2  n\)]\)\>\"", 
           ",", "\"\<Log[\!\(\*SubscriptBox[\(a\), \(k, n\)]\)]\>\""}], 
          "}"}]}], ",", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", 
             SqrtBox[
              RowBox[{"2", 
               RowBox[{"(", 
                RowBox[{"maxlevel", "+", "1"}], ")"}]}]]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{
              RowBox[{"Log", "[", 
               RowBox[{
                RowBox[{"data", "[", 
                 RowBox[{"[", "maxlevel", "]"}], "]"}], "[", "rep", "]"}], 
               "]"}], "+", "1"}]}], "}"}]}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Representation \>\"", "<>", 
       RowBox[{"ToString", "[", "rep", "]"}], "<>", "\"\<, Dimension=\>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"Dimrep", "[", "rep", "]"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"Show", "[", "bplot", "]"}], "]"}], ";", 
     RowBox[{"nz", "=", 
      RowBox[{"SelectFirst", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Transpose", "[", "logdata", "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#1", ">=", "0"}], "&"}], "->", "\"\<Index\>\""}]}], 
       "]"}]}], ";", 
     RowBox[{"lb", "=", 
      SqrtBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "nz"}], "+", "1"}], ")"}]]}], ";", 
     RowBox[{"ub", "=", 
      SqrtBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "nz"}], "+", "25"}], ")"}]]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"bplotzoom", "=", 
      RowBox[{"ListPlot", "[", 
       RowBox[{"logdata", ",", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"lb", ",", "ub"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"Log", "[", 
              RowBox[{
               RowBox[{"data", "[", 
                RowBox[{"[", 
                 RowBox[{"nz", "+", "12"}], "]"}], "]"}], "[", "rep", "]"}], 
              "]"}]}], "}"}]}], "}"}]}], ",", 
        RowBox[{"PlotStyle", "->", 
         RowBox[{"{", 
          RowBox[{"Red", ",", 
           RowBox[{"PointSize", "[", ".012", "]"}]}], "}"}]}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"explist", "=", 
      RowBox[{"{", 
       RowBox[{
       "1", ",", "8", ",", "15", ",", "22", ",", "29", ",", "36", ",", "51"}],
        "}"}]}], ";", "\n", 
     RowBox[{"BI0", "=", 
      FractionBox[
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"2", " ", "\[Pi]", " ", "x"}]], 
       SuperscriptBox["x", 
        RowBox[{"83", "/", "2"}]]]}], ";", 
     RowBox[{"bes0", "=", 
      RowBox[{"Log", "[", 
       RowBox[{"BI0", " ", 
        RowBox[{"coefflist", "[", 
         RowBox[{"[", 
          RowBox[{"posrep", ",", "2", ",", "1"}], "]"}], "]"}]}], "]"}]}], ";", 
     RowBox[{"bes0plot", "=", 
      RowBox[{"Plot", "[", 
       RowBox[{"bes0", ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "1", ",", 
          SqrtBox[
           RowBox[{"2", 
            RowBox[{"(", 
             RowBox[{"maxlevel", "+", "1"}], ")"}]}]]}], "}"}], ",", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{
            RowBox[{"Log", "[", 
             RowBox[{
              RowBox[{"data", "[", 
               RowBox[{"[", "maxlevel", "]"}], "]"}], "[", "rep", "]"}], 
             "]"}], "+", "1"}]}], "}"}]}], ",", 
        RowBox[{"PlotStyle", "->", "Orange"}], ",", 
        RowBox[{"AxesLabel", "->", 
         RowBox[{"{", 
          
          RowBox[{"\"\<\!\(\*SqrtBox[\(2  n\)]\)\>\"", 
