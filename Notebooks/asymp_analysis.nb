          RowBox[{"q", "+", "r", "+", 
           RowBox[{"s", "/", "2"}]}], ",", 
          RowBox[{"r", "+", 
           RowBox[{"s", "/", "2"}]}], ",", 
          RowBox[{"s", "/", "2"}]}], "}"}]}], ";", 
       RowBox[{"g", "=", 
