Cell[CellGroupData[{

Cell["Second Rademacher", "Section",
 CellChangeTimes->{{3.986401113492135*^9, 
  3.986401117332183*^9}},ExpressionUUID->"f6774f5c-d52a-4ab0-a3f9-\
8be45d2d0765"],

Cell["\<\
The second Rademacher coefficient comes from either \[Omega]1,\[Omega]2,\
\[Omega]3=0,\[Pi]  and \[Omega]4=+- \[Pi]/2 plus permutations,  or
\[Omega]1,\[Omega]2,\[Omega]3=+- \[Pi]/2, \[Omega]4=0,\[Pi]  plus \
permutations.  \
\>", "Text",
 CellChangeTimes->{{3.9864011502400217`*^9, 3.9864014019282713`*^9}, {
