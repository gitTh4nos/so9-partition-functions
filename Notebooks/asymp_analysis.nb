         RowBox[{"Length", "[", 
          RowBox[{"coefflist", "[", 
           RowBox[{"[", 
            RowBox[{"posrep", ",", "2"}], "]"}], "]"}], "]"}], "-", "1"}], ",", 
        RowBox[{"Length", "[", 
         RowBox[{"coefflist", "[", 
          RowBox[{"[", 
           RowBox[{"posrep", ",", "2"}], "]"}], "]"}], "]"}]}], "}"}]}], ";", 
     "\n", 
     RowBox[{"BI0", "=", 
      FractionBox[
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"2", " ", "\[Pi]", " ", "x"}]], 
       SuperscriptBox["x", 
        RowBox[{"83", "/", "2"}]]]}], ";", 
     RowBox[{"bes0", "=", 
      RowBox[{"Log", "[", 
       RowBox[{"BI0", " ", 
        RowBox[{"coefflist", "[", 
         RowBox[{"[", 
          RowBox[{"posrep", ",", "2", ",", "1"}], "]"}], "]"}]}], "]"}]}], ";", 
     RowBox[{"bes0plot", "=", 
      RowBox[{"Plot", "[", 
       RowBox[{"bes0", ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "1", ",", 
          SqrtBox[
           RowBox[{"2", 
            RowBox[{"(", 
             RowBox[{"maxlevel", "+", "1"}], ")"}]}]]}], "}"}], ",", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{
            RowBox[{"Log", "[", 
             RowBox[{
              RowBox[{"data", "[", 
               RowBox[{"[", "maxlevel", "]"}], "]"}], "[", "rep", "]"}], 
             "]"}], "+", "1"}]}], "}"}]}], ",", 
        RowBox[{"PlotStyle", "->", "Orange"}], ",", 
        RowBox[{"AxesLabel", "->", 
         RowBox[{"{", 
          
          RowBox[{"\"\<\!\(\*SqrtBox[\(2  n\)]\)\>\"", 
           ",", "\"\<Log[\!\(\*SubscriptBox[\(a\), \(k, n\)]\)]\>\""}], 
          "}"}]}]}], "]"}]}], ";", 
     RowBox[{"Print", "[", 
      RowBox[{"Show", "[", 
       RowBox[{"bes0plot", ",", "bplot"}], "]"}], "]"}], ";", "\n", 
     RowBox[{"besTab", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"BIa", "[", 
             RowBox[{
              RowBox[{"40", "+", 
               RowBox[{"2", 
                RowBox[{"(", 
                 RowBox[{"i", "-", "1"}], ")"}]}]}], ",", "x"}], "]"}], 
            RowBox[{"coefflist", "[", 
             RowBox[{"[", 
              RowBox[{"posrep", ",", "2", ",", "i"}], "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "j"}], "}"}]}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "explist"}], "}"}]}], "]"}]}], ";", "\n", 
     RowBox[{"besplot", "=", 
      RowBox[{"Plot", "[", 
       RowBox[{"besTab", ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "1", ",", 
          SqrtBox[
           RowBox[{"2", 
            RowBox[{"(", 
             RowBox[{"maxlevel", "+", "1"}], ")"}]}]]}], "}"}], ",", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{
            RowBox[{"Log", "[", 
             RowBox[{
              RowBox[{"data", "[", 
               RowBox[{"[", "maxlevel", "]"}], "]"}], "[", "rep", "]"}], 
             "]"}], "+", "1"}]}], "}"}]}], ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"explist", "-", "1"}]}]}], "]"}]}], ";", "\n", 
     RowBox[{"besplot1", "=", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"besTab", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "1", ",", 
          SqrtBox[
           RowBox[{"2", 
            RowBox[{"(", 
             RowBox[{"maxlevel", "+", "1"}], ")"}]}]]}], "}"}], ",", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{
            RowBox[{"Log", "[", 
             RowBox[{
              RowBox[{"data", "[", 
               RowBox[{"[", "maxlevel", "]"}], "]"}], "[", "rep", "]"}], 
             "]"}], "+", "1"}]}], "}"}]}]}], "]"}]}], ";", 
     RowBox[{"Print", "[", 
      RowBox[{"Show", "[", 
       RowBox[{"bplot", ",", "besplot1", ",", "bes0plot"}], "]"}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"Show", "[", 
       RowBox[{"besplot", ",", "bplot", ",", "bes0plot"}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"Show", "[", 
       RowBox[{"bplotzoom", ",", "besplot"}], "]"}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
